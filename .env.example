# ===================================================================
# TaskFlowe - Master Environment Variables Template (.env.example)
# ===================================================================
# Copy this file to .env and configure values before running Docker Compose or deploying to production.

# -------------------------------------------------------------------
# Server & Network Configuration
# -------------------------------------------------------------------
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
CLIENT_PORT=80

# -------------------------------------------------------------------
# MySQL Relational Database Configuration
# -------------------------------------------------------------------
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=TaskFlowe_db
DB_USER=TaskFlowe
DB_USER_PASSWORD=TaskFlowe_secure_password_123
DB_PASSWORD=root_super_secure_password_999

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000

# -------------------------------------------------------------------
# Security & JWT Authentication Credentials
# -------------------------------------------------------------------
# MUST BE A MINIMUM 256-BIT (64-character) HEXADECIMAL OR BASE64 ENCODED SECRET KEY IN PRODUCTION
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# -------------------------------------------------------------------
# Logging & Actuator Controls
# -------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_TaskFlowE=INFO
ACTUATOR_EXPOSED_ENDPOINTS=health,info,metrics
